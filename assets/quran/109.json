[{"ayetNo":1,"globalAyetNo":6208,"arapca":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","mealTr":"De ki: \"Ey inkarcılar!\"","mealEn":"Say, \"O disbelievers,","cuz":30,"sayfa":603},{"ayetNo":2,"globalAyetNo":6209,"arapca":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","mealTr":"\"Ben sizin taptıklarınıza tapmam.\"","mealEn":"I do not worship what you worship.","cuz":30,"sayfa":603},{"ayetNo":3,"globalAyetNo":6210,"arapca":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","mealTr":"\"Benim taptığıma da sizler tapmazsınız.\"","mealEn":"Nor are you worshippers of what I worship.","cuz":30,"sayfa":603},{"ayetNo":4,"globalAyetNo":6211,"arapca":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","mealTr":"\"Ben de sizin taptığınıza tapacak değilim.\"","mealEn":"Nor will I be a worshipper of what you worship.","cuz":30,"sayfa":603},{"ayetNo":5,"globalAyetNo":6212,"arapca":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","mealTr":"\"Benim taptığıma da sizler tapmıyorsunuz.\"","mealEn":"Nor will you be worshippers of what I worship.","cuz":30,"sayfa":603},{"ayetNo":6,"globalAyetNo":6213,"arapca":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","mealTr":"\"Sizin dininiz size, benim dinim banadır.\"","mealEn":"For you is your religion, and for me is my religion.\"","cuz":30,"sayfa":603}]